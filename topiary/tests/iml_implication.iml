(* Issue #16: keep each side's relations together; break before `==>`, and after it where written *)
verify (fun t1 t2 ->
  t1 <= t2
  ==>
  band_rank (classify t1) <= band_rank (classify t2)
)

verify (fun a b c -> a && b==>c==>a || b)

verify (fun a b c ->
  a && b
  ==> c ==> (fun x -> x) a
  ==> a || b)

theorem imp_pair a b c = (a ==> b, c) = ((a ==> b), c)

let imp = ( ==> )

verify (fun a b c -> a<==b<==c)

verify (fun a b c -> a ==> b<==>c <== a)

verify (fun a b c ->
  a || b
  <==> c ==> a)

let ops = (( <== ), ( <==> ))

(* A break after the operator is kept only where the author wrote one *)
verify (fun t1 t2 -> t1 <= t2 ==>
  band_rank (classify t1) <= band_rank (classify t2))

verify (fun a b c ->
  a
  ==> b ==>
  c
  ==> (match a with
       | true -> b
       | false -> c))
