{
  "grammars": [
    {
      "name": "iml",
      "camelcase": "IML",
      "scope": "source.iml",
      "path": "grammars/iml",
      "external-files": [
        "common/scanner.h"
      ],
      "file-types": [
        "iml"
      ],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^iml$"
    }
  ],
  "metadata": {
    "version": "0.27.1",
    "license": "MIT",
    "description": "IML grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/imandra-ai/tree-sitter-iml"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
